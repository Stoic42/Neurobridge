# NeuroBridge Environment Configuration

# Qwen API Configuration (Primary)
QWEN_API_KEY=your_qwen_api_key_here

# XAI API Configuration (Secondary)
XAI_API_KEY=your_xai_api_key_here

# Wenxin API Configuration
WENXIN_API_KEY=your_wenxin_api_key_here
WENXIN_SECRET_KEY=your_wenxin_secret_key_here

# OpenAI API Configuration  
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173