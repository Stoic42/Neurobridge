[Unit]
Description=NeuroBridge Backend API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/neurobridge/backend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/neurobridge/backend/.env
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
